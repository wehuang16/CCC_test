within CCC_test.EvaporativeCooler.OpenTank;
package Validation "Collection of models that validate the open tank model"

  extends Modelica.Icons.ExamplesPackage;

  annotation (Documentation(info="<html>
<p>
This package contains models that validate the models in
<a href=\"modelica://CCC_test.EvaporativeCooler.OpenTank\">
Buildings.Fluid.Humidifiers.EvaporativeCoolers.OpenTank</a>. The examples plot various
outputs. These model outputs are stored as reference data to allow continuous
validation whenever models in the library change. </p>
</html>"));
end Validation;
